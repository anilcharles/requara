# Speklo self-hosted settings. Copy to .env and change every "change-me".

# Release to run, e.g. 1.4.0. Pin it in production instead of "latest".
SPEKLO_VERSION=latest

# Where people open Speklo. Must be reachable from browsers and the desktop app.
# Behind a TLS reverse proxy, use the https:// URL here.
SPEKLO_URL=http://localhost:8080
SPEKLO_PORT=8080

# Shown on the sign-in screens.
SPEKLO_ORG_NAME=Your Company

# ---------------------------------------------------------------------------
# Sign-in providers. Enable any number; the sign-in screens list them in this
# order. Every provider uses the same callback URL:
#
#     ${SPEKLO_URL}/auth/callback        (e.g. http://localhost:8080/auth/callback)
#
# google, microsoft, github and gitlab are presets that need only a client ID
# and secret. Any other id is a generic OpenID Connect provider (Okta, Auth0,
# Keycloak, Authentik, Zitadel, …) and needs an ISSUER.
# Setup steps for each: README.md
# ---------------------------------------------------------------------------
SPEKLO_AUTH_PROVIDERS=google,github

# Google
SPEKLO_AUTH_GOOGLE_CLIENT_ID=change-me
SPEKLO_AUTH_GOOGLE_CLIENT_SECRET=change-me

# GitHub (orgs and teams become groups, e.g. "acme" and "acme/platform")
SPEKLO_AUTH_GITHUB_CLIENT_ID=change-me
SPEKLO_AUTH_GITHUB_CLIENT_SECRET=change-me
# Only let members of these GitHub organizations sign in (recommended):
SPEKLO_AUTH_GITHUB_ALLOWED_ORGS=
# GitHub Enterprise Server: SPEKLO_AUTH_GITHUB_URL=https://github.your-company.com

# Microsoft Entra ID — add "microsoft" to SPEKLO_AUTH_PROVIDERS:
# SPEKLO_AUTH_MICROSOFT_CLIENT_ID=
# SPEKLO_AUTH_MICROSOFT_CLIENT_SECRET=
# SPEKLO_AUTH_MICROSOFT_TENANT=<your tenant id>      # default "organizations" = any work account

# GitLab — add "gitlab":
# SPEKLO_AUTH_GITLAB_CLIENT_ID=
# SPEKLO_AUTH_GITLAB_CLIENT_SECRET=
# SPEKLO_AUTH_GITLAB_URL=https://gitlab.your-company.com   # self-managed GitLab

# Your company's SSO (any OIDC provider) — add e.g. "okta":
# SPEKLO_AUTH_OKTA_NAME=Acme SSO                       # button: "Continue with Acme SSO"
# SPEKLO_AUTH_OKTA_ISSUER=https://acme.okta.com/oauth2/default
# SPEKLO_AUTH_OKTA_CLIENT_ID=
# SPEKLO_AUTH_OKTA_CLIENT_SECRET=
# Optional for any OIDC provider:
# SPEKLO_AUTH_OKTA_SCOPES=openid profile email groups
# SPEKLO_AUTH_OKTA_ROLES_CLAIM=roles                   # claim paths, comma-separated
# SPEKLO_AUTH_OKTA_GROUPS_CLAIM=groups
# SPEKLO_AUTH_OKTA_ACCOUNT_URL=https://acme.okta.com/enduser/settings
# SPEKLO_AUTH_OKTA_DISCOVERY_URL=                      # if this server reaches the IdP at another address

# ---------------------------------------------------------------------------
# Who may join. With public providers (Google, GitHub without ALLOWED_ORGS,
# GitLab.com, Microsoft "organizations"), anyone with an account there could
# sign in — so limit it. People with a pending invite can always join.
SPEKLO_ALLOWED_DOMAINS=your-company.com

# Roles or groups (names, or the last part of a group path) that make someone a
# workspace owner, and that may publish API versions. Owners can always publish.
SPEKLO_ADMIN_GROUPS=speklo-admin
SPEKLO_PUBLISHER_GROUPS=speklo-admin,api-designer

# ---------------------------------------------------------------------------
# Secrets. Generate each with: openssl rand -hex 24
POSTGRES_PASSWORD=change-me
S3_SECRET_KEY=change-me

# Email for invites (host:port of your SMTP relay). Leave empty to skip email.
SMTP_ADDR=
SMTP_FROM=Speklo <no-reply@example.com>

# Let the request runner call private/internal addresses (10.x, 192.168.x, localhost).
# Leave false unless your APIs are internal: it lets users reach anything this server can.
SPEKLO_ALLOW_PRIVATE_NETWORK=false
