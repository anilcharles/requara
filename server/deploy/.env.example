# Requara self-hosted settings. Copy to .env and change every "change-me".

# Release to run, e.g. 1.4.0. Pin it in production instead of "latest".
REQUARA_VERSION=latest

# Where people open Requara. Must be reachable from browsers and the desktop app.
# Behind a TLS reverse proxy, use the https:// URL here.
REQUARA_URL=http://localhost:8080
REQUARA_PORT=8080

# Shown on the sign-in screens.
REQUARA_ORG_NAME=Your Company

# ---------------------------------------------------------------------------
# Sign-in providers. Enable any number; the sign-in screens list them in this
# order. Every provider uses the same callback URL:
#
#     ${REQUARA_URL}/auth/callback        (e.g. http://localhost:8080/auth/callback)
#
# google, microsoft, github and gitlab are presets that need only a client ID
# and secret. Any other id is a generic OpenID Connect provider (Okta, Auth0,
# Keycloak, Authentik, Zitadel, …) and needs an ISSUER.
# Setup steps for each: README.md
# ---------------------------------------------------------------------------
REQUARA_AUTH_PROVIDERS=google,github

# Google
REQUARA_AUTH_GOOGLE_CLIENT_ID=change-me
REQUARA_AUTH_GOOGLE_CLIENT_SECRET=change-me

# GitHub (orgs and teams become groups, e.g. "acme" and "acme/platform")
REQUARA_AUTH_GITHUB_CLIENT_ID=change-me
REQUARA_AUTH_GITHUB_CLIENT_SECRET=change-me
# Only let members of these GitHub organizations sign in (recommended):
REQUARA_AUTH_GITHUB_ALLOWED_ORGS=
# GitHub Enterprise Server: REQUARA_AUTH_GITHUB_URL=https://github.your-company.com

# Microsoft Entra ID — add "microsoft" to REQUARA_AUTH_PROVIDERS:
# REQUARA_AUTH_MICROSOFT_CLIENT_ID=
# REQUARA_AUTH_MICROSOFT_CLIENT_SECRET=
# REQUARA_AUTH_MICROSOFT_TENANT=<your tenant id>      # default "organizations" = any work account

# GitLab — add "gitlab":
# REQUARA_AUTH_GITLAB_CLIENT_ID=
# REQUARA_AUTH_GITLAB_CLIENT_SECRET=
# REQUARA_AUTH_GITLAB_URL=https://gitlab.your-company.com   # self-managed GitLab

# Your company's SSO (any OIDC provider) — add e.g. "okta":
# REQUARA_AUTH_OKTA_NAME=Acme SSO                       # button: "Continue with Acme SSO"
# REQUARA_AUTH_OKTA_ISSUER=https://acme.okta.com/oauth2/default
# REQUARA_AUTH_OKTA_CLIENT_ID=
# REQUARA_AUTH_OKTA_CLIENT_SECRET=
# Optional for any OIDC provider:
# REQUARA_AUTH_OKTA_SCOPES=openid profile email groups
# REQUARA_AUTH_OKTA_ROLES_CLAIM=roles                   # claim paths, comma-separated
# REQUARA_AUTH_OKTA_GROUPS_CLAIM=groups
# REQUARA_AUTH_OKTA_ACCOUNT_URL=https://acme.okta.com/enduser/settings
# REQUARA_AUTH_OKTA_DISCOVERY_URL=                      # if this server reaches the IdP at another address

# One-time email links — add "email" (needs SMTP_ADDR below):
#   REQUARA_AUTH_PROVIDERS=email,google

# SAML 2.0 (Okta, Entra ID, Google Workspace, ADFS, OneLogin, …) — add e.g.
# "corp" with TYPE=saml. Register Requara at the IdP with:
#     ACS URL   ${REQUARA_URL}/auth/saml/corp/acs
#     Entity ID ${REQUARA_URL}/auth/saml/corp/metadata   (also its metadata URL)
# REQUARA_AUTH_CORP_TYPE=saml
# REQUARA_AUTH_CORP_NAME=Acme SSO
# REQUARA_AUTH_CORP_METADATA_URL=https://acme.okta.com/app/xyz/sso/saml/metadata
#   …or a file in ./saml:  REQUARA_AUTH_CORP_METADATA_FILE=/etc/requara/saml/idp-metadata.xml
#   …or the SSO URL and certificate: REQUARA_AUTH_CORP_SSO_URL=… REQUARA_AUTH_CORP_IDP_CERT_FILE=/etc/requara/saml/idp.pem
# Optional: _EMAIL_ATTR, _NAME_ATTR, _GROUPS_ATTR (attribute names),
#   _ENTITY_ID, _SP_CERT_FILE + _SP_KEY_FILE (sign requests, decrypt assertions)

# ---------------------------------------------------------------------------
# Instance admins manage users, workspaces, the audit log, admin tokens and
# settings in the admin console (/admin). They're named here, never in the
# browser: list emails in admins.txt (a Docker secret) and/or below. An admin
# must sign in with that email, verified by their provider. Changes apply at
# the next `docker compose up -d`.
REQUARA_ADMIN_EMAILS=
# Use another file for the admins secret: REQUARA_ADMINS_FILE=/path/to/admins.txt

# Audit log: days to keep events (0 = forever).
REQUARA_AUDIT_RETENTION_DAYS=365

# ---------------------------------------------------------------------------
# Who may join. With public providers (Google, GitHub without ALLOWED_ORGS,
# GitLab.com, Microsoft "organizations", email links), anyone with an account
# there could sign in — so limit it. People with a pending invite, provisioned
# by SCIM, or listed as admins can always join.
REQUARA_ALLOWED_DOMAINS=your-company.com

# Roles or groups (names, or the last part of a group path) that make someone a
# workspace owner, and that may publish API versions. Owners can always publish.
REQUARA_ADMIN_GROUPS=requara-admin
REQUARA_PUBLISHER_GROUPS=requara-admin,api-designer

# ---------------------------------------------------------------------------
# Secrets. Generate each with: openssl rand -hex 24
POSTGRES_PASSWORD=change-me
S3_SECRET_KEY=change-me

# Email for invites and email sign-in links (host:port of your SMTP relay).
# Leave empty to skip email (then the "email" sign-in provider can't be used).
SMTP_ADDR=
SMTP_FROM=Requara <no-reply@example.com>

# Let the request runner call private/internal addresses (10.x, 192.168.x, localhost).
# Leave false unless your APIs are internal: it lets users reach anything this server can.
REQUARA_ALLOW_PRIVATE_NETWORK=false

# Outbound proxy for requests Requara sends (and sign-in, token and spec
# downloads). Requests can set their own proxy in their Settings tab, but only
# this one may be on a private address. Keep Requara's own services in NO_PROXY.
#HTTPS_PROXY=http://proxy.your-company.com:3128
#HTTP_PROXY=http://proxy.your-company.com:3128
#NO_PROXY=localhost,127.0.0.1,openbao,s3
