{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "include-component-in-tag": true,
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": true,
  "packages": {
    "server": {
      "component": "server",
      "package-name": "requara-server",
      "release-type": "simple",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "yaml",
          "path": "deploy/helm/requara/Chart.yaml",
          "jsonpath": "$.version"
        },
        {
          "type": "yaml",
          "path": "deploy/helm/requara/Chart.yaml",
          "jsonpath": "$.appVersion"
        }
      ]
    },
    "desktop": {
      "component": "desktop",
      "package-name": "requara-desktop",
      "release-type": "rust",
      "changelog-path": "CHANGELOG.md"
    }
  }
}
